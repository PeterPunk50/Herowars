 PROX={LowerTorso="Root",UpperTorso="Waist",Head="Neck",LeftUpperArm="LeftShoulder",LeftLowerArm="LeftElbow",
  LeftHand="LeftWrist",RightUpperArm="RightShoulder",RightLowerArm="RightElbow",RightHand="RightWrist",
