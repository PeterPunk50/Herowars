+;(function()
+ -- R66-ui10 (Peter: "Bulwark's jump increased so he can get up the steps; Wraith has spider climb, he doesn't have
+ -- to press the button; Bulwark climbs up if he is short in his jump"): climbing for your own fighter, every frame
+ -- while you control your movement. Settings: Rules.Climb; the work is in ReplicatedStorage.HeroWars.Climb.
+ local ok,Climb=pcall(function() return require(RS.HeroWars:WaitForChild("Climb",10)) end)
+ if not ok or not Climb then warn("[HeroWars] climbing off: "..tostring(Climb)); return end
+ RunService.PreSimulation:Connect(function()
+  local model=player.Character
+  if not model or not model:GetAttribute("ClientMove") or model:GetAttribute("Locked") or model:GetAttribute("Flying") then return end
+  local cfg=Rules.Climb and Rules.Climb[model:GetAttribute("Hero") or ""]
+  if not cfg then return end
+  local hum=model:FindFirstChildOfClass("Humanoid"); local root=model:FindFirstChild("HumanoidRootPart")
+  if not hum or not root or hum.WalkSpeed<=9 then return end -- attacking or guarding: no climbing
+  Climb.step(cfg,model,root,hum,hum.MoveDirection)
+ end)
+end)()
