 local pos=self.pos
 if wantState~="Idle" and steered and self:clearAhead(12) then
  local fwd=Vector3.new(-math.sin(yaw),0,-math.cos(yaw))
  pos=pos+fwd*D.Speed[wantState]*dt
 end
 self:moveTo(pos,yaw)
end
